# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Local demo values only.

# Postgres (read by docker-compose.yml)
POSTGRES_USER=keyloop
POSTGRES_PASSWORD=keyloop
POSTGRES_DB=keyloop
POSTGRES_PORT=5432

# Backend (read by the API and the seed command)
# Keep the credentials and port in step with the Postgres values above.
DATABASE_URL=postgres://keyloop:keyloop@127.0.0.1:5432/keyloop?sslmode=disable
# At least 32 bytes. Demo value only; use a random secret anywhere real.
JWT_SECRET=demo-only-jwt-secret-change-me-0123456789
# Optional: ADDR=:8080  JWT_TTL=1h  SEED_DIR=seed
